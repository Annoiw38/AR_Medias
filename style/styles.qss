QWidget#centralWidget {
    background-color: #1e1e2e;
}
QLabel {
    color: #cdd6f4;
    font-size: 16px;
    font-family: "Segoe UI";
}
QPushButton {
    background-color: #89b4fa;
    color: #1e1e2e;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #b4befe;
}

QPushButton#previous_btn {
    min-width: 50px;
    min-height: 50px;
    max-width: 50px;
    max-height: 50px;
    padding: 8px;
    background-color: #f38ba8;
}
QPushButton#play_btn{
    min-width: 50px;
    min-height: 50px;
    max-width: 50px;
    max-height: 50px;
    padding: 8px;
    background-color: #f38ba8;
}
QPushButton#next_btn{
    min-width: 50px;
    min-height: 50px;
    max-width: 50px;
    max-height: 50px;
    padding: 8px;
    background-color: #f38ba8;
}

QLineEdit, QComboBox, QTextEdit, QListWidget {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px;
}

QPixmap#album_image{
    border: 2px solid;
}
QLabel#artist_name {
    width: 5px;
    spacing: 0px;
    color: #cdd6f4;
    font-size: 8px;
    font-family: "Segoe UI";
}